<?xml version="1.0"?>
<!--
  O6 Hand (LinkerHand) standalone test URDF
  
  This file creates a minimal robot description with only the O6 hand
  for standalone testing without the full bimanual arm system.
  
  Usage:
    ros2 launch openarm_bringup o6_hand_hardware_test.launch.py can_interface:=can2
    ros2 launch openarm_bringup o6_hand_hardware_test.launch.py use_fake_hardware:=true
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="o6_hand">

  <!-- Arguments -->
  <xacro:arg name="can_interface" default="can2" />
  <xacro:arg name="hand_type" default="right" />
  <xacro:arg name="use_fake_hardware" default="false" />
  <xacro:arg name="move_to_home" default="false" />
  <xacro:arg name="hand_prefix" default="R_" />
  <xacro:arg name="description_pkg" default="openarm_description" />

  <!-- World link -->
  <link name="world"/>
  
  <!-- Hand mount link (simple box for visualization) -->
  <link name="hand_mount">
    <visual>
      <geometry>
        <box size="0.05 0.1 0.02"/>
      </geometry>
      <material name="mount_material">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>
  
  <!-- Fixed joint from world to hand mount -->
  <joint name="world_to_hand" type="fixed">
    <parent link="world"/>
    <child link="hand_mount"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Include O6 hand xacro from external openarm_description package -->
  <xacro:arg name="description_pkg" default="openarm_description" />
  <xacro:include filename="$(find openarm_description)/urdf/ee/o6_hand_right.xacro" ns="o6_right"/>
  <xacro:include filename="$(find openarm_description)/urdf/ee/o6_hand_left.xacro" ns="o6_left"/>
  
  <!-- Instantiate O6 hand based on hand_type argument -->
  <xacro:if value="${'$(arg hand_type)' == 'right'}">
    <xacro:o6_right.o6_hand_right_impl connected_to="hand_mount" xyz_ee="0 0 0" rpy_ee="0 0 0"/>
  </xacro:if>
  
  <xacro:if value="${'$(arg hand_type)' == 'left'}">
    <xacro:o6_left.o6_hand_left_impl connected_to="hand_mount" xyz_ee="0 0 0" rpy_ee="0 0 0"/>
  </xacro:if>

  <!-- ros2_control hardware interface -->
  <ros2_control name="O6HandHardware" type="system">
    <hardware>
      <xacro:if value="$(arg use_fake_hardware)">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_fake_hardware)">
        <plugin>openarm_hardware/O6HandHardware</plugin>
        <param name="can_interface">$(arg can_interface)</param>
        <param name="hand_type">$(arg hand_type)</param>
        <param name="hand_prefix">$(arg hand_prefix)</param>
        <param name="move_to_home">$(arg move_to_home)</param>
      </xacro:unless>
    </hardware>

    <!-- O6 Hand has 6 controllable DOF:
         0: Thumb CMC Yaw (R_thumb_cmc_yaw)
         1: Thumb CMC Pitch (R_thumb_cmc_pitch) 
         2: Index MCP Pitch (R_index_mcp_pitch)
         3: Middle MCP Pitch (R_middle_mcp_pitch)
         4: Ring MCP Pitch (R_ring_mcp_pitch)
         5: Pinky MCP Pitch (R_pinky_mcp_pitch)
         
         Note: DIP joints are mechanically coupled or passive,
         not directly controlled by the 6 DOF SDK
    -->
    <xacro:property name="prefix" value="$(arg hand_prefix)" />
    
    <joint name="${prefix}thumb_cmc_yaw">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="${prefix}thumb_cmc_pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="${prefix}index_mcp_pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="${prefix}middle_mcp_pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="${prefix}ring_mcp_pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="${prefix}pinky_mcp_pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>
